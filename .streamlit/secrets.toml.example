# Copy this file to .streamlit/secrets.toml for local development.
# Never commit the real secrets.toml file.

SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_KEY = "YOUR_PUBLISHABLE_OR_ANON_KEY"

# Required after applying database_schema_supabase.sql, because public SELECT is disabled.
# Keep this key only in Streamlit Secrets. Never put it in HTML or commit it to GitHub.
SUPABASE_ADMIN_KEY = "YOUR_SERVICE_ROLE_KEY"

# Optional. Streamlit can normally detect its public URL after deployment.
PUBLIC_APP_URL = "https://YOUR_APP_NAME.streamlit.app"

# Optional override; the default already points to DocterCloud production.
DOCTERCLOUD_BASE_URL = "https://icare.docter.pro/back-end/app"
